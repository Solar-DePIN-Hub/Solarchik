# Server-side env vars for Solarchik (set them in Vercel → Project → Settings → Environment Variables).
# Never prefix a secret with VITE_: anything VITE_* is baked into the browser bundle.

# --- Database (Neon / Postgres). Required for arb caps and the free-mint claim lock. ---
# Without it on a deploy, arb firing is CLOSED (fail closed) and free mint relies on the on-chain check only.
DATABASE_URL=

# --- Arb desk ---
# Mainnet arb stays OFF unless this is exactly "true" AND DATABASE_URL is set.
# Unset = simulation on the live Backpack book, nothing signed or sent, arb credit not spent.
ARB_MAINNET_ENABLED=
# Mainnet arb also needs the house keys that arb-house.server.ts reads from server/arb-house.key,
# server/backpack.secret and server/titan.secret (gitignored files, not env vars). Without them mainnet refuses.

# --- Solana RPC (optional; public nodes when unset). Keep provider tokens here, never in source. ---
SOLANA_RPC_DEVNET=
SOLANA_RPC_MAINNET=

# --- Cloudflare desk worker token. Server only; injected by /api/desk/* and server functions. ---
# Must equal the DESK_TOKEN secret on the solarchik-desk worker. Rotate it (the old one is in git history).
DESK_TOKEN=
# Optional: extra browser origins allowed to call /api/desk/* (comma separated). Same origin is always allowed.
DESK_PROXY_ORIGINS=

# --- Build-time, public (not a secret) ---
# Only for the native/offline web bundle: absolute origin of the deployed app that serves /api/desk/*.
VITE_DESK_PROXY_ORIGIN=

# --- Existing keys used elsewhere (unchanged) ---
XAI_API_KEY=
GEMINI_API_KEY=
